{
  "name": "patrones-ui-fullstack",
  "private": true,
  "version": "1.0.0",
  "description": "Laboratorios FICCT – Catálogo de Patrones UI con backend Express + SQLite (INF513 Grupo 08 SA)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:servidor\" \"npm:cliente\"",
    "servidor": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "cliente": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "db:reset": "node --disable-warning=ExperimentalWarning server/reset.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
